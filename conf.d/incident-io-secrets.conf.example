/*
 * incident.io credentials.
 *
 * Copy to /etc/icinga2/conf.d/incident-io-secrets.conf on EVERY master, then:
 *
 *   chown root:icinga /etc/icinga2/conf.d/incident-io-secrets.conf
 *   chmod 0640        /etc/icinga2/conf.d/incident-io-secrets.conf
 *
 * Keep this OUT of zones.d - config sync transmits over TLS but also writes the
 * file to /var/lib/icinga2/api/zones on every node in the zone. Holding the
 * token in conf.d on each master keeps it off the sync path entirely.
 */

/* From incident.io: Settings -> Alerts -> Sources -> your HTTP source. */
const IncidentIoUrl   = "https://api.incident.io/v2/alert_events/http/YOUR_ALERT_SOURCE_ID"
const IncidentIoToken = "YOUR_ALERT_SOURCE_TOKEN"

/* Base URL of your Icinga Web 2 install. Used to build a source_url on each
 * alert so responders can jump straight to the object. Leave "" to omit. */
const IncidentIoIcingaWebUrl = "https://icinga.example.com/icingaweb2"

/* Optional: metadata attached to every alert from this Icinga instance.
 * Useful when several Icinga estates feed one incident.io account. */
globals.IncidentIoDefaultMetadata = {
  icinga_instance = "primary"
  environment     = "production"
}
