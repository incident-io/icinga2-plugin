/*
 * incident.io credentials.
 *
 * Copy to /etc/icinga2/conf.d/incident-io-secrets.conf on EVERY master, then:
 *
 *   chown root:icinga /etc/icinga2/conf.d/incident-io-secrets.conf
 *   chmod 0640        /etc/icinga2/conf.d/incident-io-secrets.conf
 *
 * Keep this OUT of zones.d. Config sync transmits over TLS but also writes the
 * file to /var/lib/icinga2/api/zones on every node in the zone, and constants
 * in conf.d are not visible to config synced from zones.d in any case.
 */

/* From incident.io: Settings -> Alerts -> Sources -> your Icinga 2 source. */
const IncidentIoUrl   = "https://api.incident.io/v2/alert_events/icinga2/YOUR_ALERT_SOURCE_ID"
const IncidentIoToken = "YOUR_ALERT_SOURCE_TOKEN"

/* Base URL of your Icinga Web 2 install. Used to build a source_url on each
 * alert so responders can jump straight to the object. Leave "" to omit. */
const IncidentIoIcingaWebUrl = "https://icinga.example.com/icingaweb2"

/* Which Icinga Web 2 front end you run, so the source_url points at a page
 * that exists:
 *
 *   "icingadb"    Icinga DB Web, the current default (Icinga 2.13 and newer)
 *   "monitoring"  the older "monitoring" module
 *
 * If you are unsure, open a host in Icinga Web 2 and look at the URL. A path
 * under /icingadb/ means "icingadb", one under /monitoring/ means
 * "monitoring".
 *
 * Optional, and set through globals rather than const so that leaving it out
 * is not an error. Omitted means "icingadb".
 */
globals.IncidentIoIcingaWebStyle = "icingadb"

/* Optional: metadata attached to every alert from this Icinga instance.
 * Useful when several Icinga estates feed one incident.io account. */
globals.IncidentIoDefaultMetadata = {
  icinga_instance = "primary"
  environment     = "production"
}
